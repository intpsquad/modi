# 로컬 개발용 환경변수 템플릿.
#
# 이 파일을 server/.env 로 복사한 뒤 값을 채운다. server/.env 는 커밋되지 않는다.
# **값 자체를 이 파일에 적지 않는다**(CLAUDE.md 규칙).
#
#   cd server && cp .env.example .env && ./gradlew bootRun
#
# build.gradle 이 bootRun 에서만 이 파일을 읽는다 — ./gradlew test 는 읽지 않는다.
# (개발자 게이트웨이 키가 테스트로 새어들어가 실제 API 를 호출하는 사고를 막기 위한 것이다.)
#
# **빈 값은 무시된다.** 안 쓸 항목은 비워두면 "설정 안 함"과 똑같이 동작한다 —
# 지우지 않아도 된다.

# --- Firebase Admin SDK ---
# 없으면 서버는 정상 부팅되지만 /me 같은 인증 보호 엔드포인트가 항상 401 이다.
# 파일 발급 방법은 README "로컬 전용 파일" 절 참고. 경로는 server/ 기준 상대경로도 된다.
FIREBASE_CREDENTIALS_PATH=src/main/resources/firebase-service-account.json

# --- MinIO (프로필 사진 · 방 대표 이미지 · 아카이브 썸네일) ---
# 먼저 `docker compose up -d` 로 minio 컨테이너를 띄운다. 콘솔은 http://localhost:9001
# 비우면 업로드 URL 발급 API 만 503 이 되고 나머지는 정상 동작한다.
# access-key/secret-key/bucket 은 application.yml 에 로컬 기본값이 있어 안 채워도 된다.
#
# **서버가 MinIO 에 접속하는 주소**다.
MINIO_ENDPOINT=http://localhost:9000
# **기기(앱)가 이미지를 받아갈 주소.** 비우면 위 값을 그대로 쓴다 — 운영에서는 그게 맞다.
#
# ⚠️ **안드로이드 에뮬레이터로 테스트한다면 반드시 10.0.2.2 로 채운다.** 에뮬레이터에서
# `localhost` 는 에뮬레이터 자신이라 개발 PC 의 MinIO 에 못 닿는다(API_BASE_URL 이
# 10.0.2.2:8080 인 것과 같은 이유). 안 채우면 **이미지만 조용히 안 뜬다** — 업로드도 DB 저장도
# 성공해서 서버 로그에는 아무 흔적이 없다(에서 실제로 겪었다).
MINIO_PUBLIC_BASE_URL=http://10.0.2.2:9000

# --- OpenAI 플랫폼 키 (아카이브 자동 태깅·요약) ---
# 값은 팀의 OpenAI 플랫폼 계정에서 발급한다(sk-...). 구성 방식은 specs/0001-architecture.md 참고.
# 비우면 자료 등록은 되지만 태그가 항상 빈 상태로 저장된다.
# (2026-08-13: 회수된 게이트웨이의 이름을 딴 변수명을 제공사 전환과 함께 개명했다.)
OPENAI_API_KEY=

# --- YouTube Data API v3 (유튜브 링크 저장) ---
# 유튜브 자료의 제목·채널명·설명·썸네일을 가져온다. **비우면 유튜브 링크만 등록에 실패한다**
# (다른 사이트는 정상). 그 경우 서버 로그에 "YOUTUBE_API_KEY 가 설정되지 않아…" 가 남는다.
#
# 발급: GCP 콘솔(Firebase 와 같은 프로젝트) → API 및 서비스 → 사용자 인증 정보 → API 키
#   · 라이브러리에서 "YouTube Data API v3" 를 먼저 사용 설정
#   · API 제한사항: YouTube Data API v3 만 선택
#   · 애플리케이션 제한사항: **없음** — IP 로 묶으면 로컬에서 이 경로를 검증할 수 없다
#     (그러면 "로컬은 되고 운영은 안 되는" 상태가 다시 생긴다, 2026-08-05 확정)
# 서비스 계정은 필요 없다 — 공개 데이터 읽기는 API 키만으로 된다.
YOUTUBE_API_KEY=

# --- SMTP (이메일 자체가입 인증코드) ---
# 비우면 인증코드 발송 API만 503이 되고 나머지는 정상 동작한다.
# Gmail을 쓴다면 SPRING_MAIL_PASSWORD는 구글 계정 비밀번호가 아니라 "앱 비밀번호"(2단계 인증
# 활성화 후 발급)를 써야 한다 — 일반 비밀번호는 SMTP 인증에서 거부된다.
SPRING_MAIL_HOST=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# --- AI 서버 (투두 추천) ---
# ai/ 를 따로 띄웠을 때만 필요하다. 기본값(http://localhost:8000)이 이미 맞으므로
# 보통 비워둔다. INTERNAL_API_KEY 는 ai/.env 의 같은 이름 값과 **똑같이** 맞춰야 한다.
AI_SERVER_BASE_URL=
INTERNAL_API_KEY=

# --- DB / Redis ---
# server/docker-compose.yml 의 기본값(modi/modi/modi, localhost)이 application.yml 에도
# 들어 있으므로 보통 비워둔다. 포트를 바꿔 띄웠을 때만 채운다.
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
SPRING_REDIS_HOST=
SPRING_REDIS_PORT=
