# 이 파일을 ai/.env 로 복사한 뒤 값을 채운다. ai/.env 는 커밋되지 않는다.
# 값 자체는 절대 이 파일에 적지 않는다(CLAUDE.md 규칙).

# --- OpenAI (직접 호출) ---
# OpenAI 플랫폼 키(sk-...). 생성·임베딩 모두 이 키를 쓴다.
# (2026-08-13: 회수된 게이트웨이의 이름을 딴 변수명을 제공사 전환과 함께 개명했다.)
# ⚠️ 이 이름을 또 바꿀 때는 운영 .env 를 **같은 배포에서** 함께 바꿔야 한다 — 어긋나면
# 서버는 정상 부팅하고 AI 기능만 조용히 꺼진다(로그에 흔적이 없다).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/

# 이 서버(투두 추천)의 생성 모델. **태깅·요약과 같은 값이다**(2026-08-13 통일).
# 추론(reasoning) 모델은 쓰지 않는다 — 게이트웨이 크레딧 등급이라는 유일한 반대 근거가 게이트웨이와 함께
# 사라졌고, OpenAI 직접 과금에서는 숨은 추론 토큰이 그대로 출력 토큰 요금이 된다.
# 실측: gpt-5-nano 14.1초·출력 2,078 tok(추론 1,984) vs gpt-5.4-nano 0.95초·92 tok(추론 0)
# → ai/docs/EXPERIMENTS.md #34.
OPENAI_MODEL=gpt-5.4-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- 내부 통신 ---
# AI 서버는 외부에 노출하지 않고 Spring만 호출한다. 그 공유 시크릿.
# Spring이 `X-Internal-Key` 헤더로 보낸다. 비워두면 검증을 건너뛴다(로컬에서 curl로 확인용) —
# 운영 compose에서는 반드시 채운다. 값은 아무 랜덤 문자열이면 된다.
INTERNAL_API_KEY=

# --- LangSmith (개발 환경 전용) ---
# 운영에서는 반드시 false. true면 사용자 자료 본문이 외부 SaaS로 전송되고
# 개인정보 처리위탁 명시·Play Console 데이터 보안 신고 대상이 된다.
#
# 이 값들은 pydantic-settings가 Settings 객체에만 채우고 os.environ에는 넣지 않는데
# LangSmith SDK는 os.environ만 본다 — modi_ai/tracing.py 가 그 간극을 메운다.
# 키가 비어 있으면 true여도 켜지 않고 경고만 남긴다(INTERNAL_API_KEY와 같은 패턴).
# 발급: LangSmith → Settings → API Keys → Personal Access Token (루트 README.md 참고)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# 트레이스가 쌓일 프로젝트 이름. **줄을 지우면** 기본값 modi-ai 가 쓰인다.
# 빈 문자열로 두면 빈 이름이 그대로 들어가 LangSmith 의 default 프로젝트로 간다.
LANGSMITH_PROJECT=modi-ai

# 후보 생성 최대 횟수. 0=검수 안 함 · 1=검수만(기본) · 2=재생성 1회.
# **평소에는 지운 채로 둔다** — 기본값이 근거를 갖고 정해져 있다(docs/EXPERIMENTS.md #28).
# A/B 를 다시 잴 때만 켠다. 러너는 `--critique 0/1/2` 로 같은 값을 넘긴다.
# ⚠️ 이 값이 .env 에 있으면 LangGraph Studio 도 그 값으로 돈다 — 운영과 다른 그림을 보게 된다.
# CRITIQUE_MAX_ATTEMPTS=1
