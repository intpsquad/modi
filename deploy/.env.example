# 운영 환경변수 템플릿.
#
# 이 파일을 서버의 /home/ubuntu/maramodi/.env 로 복사한 뒤 값을 채운다.
# **값 자체를 이 파일에 적지 않는다**(CLAUDE.md 규칙). 실제 .env 는 .gitignore 로 막혀 있다.
#
#   scp deploy/.env.example modi:/home/ubuntu/maramodi/.env
#   ssh modi 'chmod 600 /home/ubuntu/maramodi/.env && vi /home/ubuntu/maramodi/.env'

# ---------- Swagger / OpenAPI 문서 Basic 인증 ----------
# api.maramodi.cloud 의 /docs · /swagger-ui/* · /v3/api-docs 를 감싸는 자격증명.
# 팀에서 공유하는 계정 하나면 된다. 비밀번호는 아래 명령으로 **해시**를 만들어 넣는다
# (평문은 어디에도 저장하지 않는다 — 팀 채널로 전달):
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '실제비밀번호'
# 비워두면 Caddy 는 정상 기동하지만 그 경로가 전부 401 이 된다(fail-closed).
DOCS_USER=modi
DOCS_PASSWORD_HASH=

# (ACME 이메일은 환경변수로 쓰지 않는다 — 값이 비면 Caddy 자체가 기동하지 않는다.
#  필요하면 deploy/Caddyfile 에 직접 적는다. 그쪽 주석 참고.)

# ---------- 카카오 네이티브 앱 키 (초대 페이지의 "앱에서 열기" 버튼) ----------
# 카톡 초대 카드가 여는 https://api.maramodi.cloud/room/join 페이지(deploy/site/join.html)가
# 이 값으로 `kakao<키>://kakaolink?...` 스킴을 만들어 설치된 앱을 연다.
# 값은 앱 빌드가 쓰는 것과 **같은 키**다 — app/env/prod.json 의 KAKAO_NATIVE_APP_KEY,
# 또는 카카오 개발자 콘솔 > 앱 설정 > 앱 키 > 네이티브 앱 키(32자리).
#
# **저장소에 커밋하지 않으려고 여기로 뺐다** — 이 저장소는 공개다.
# 비워두면 페이지는 정상 동작하고 "앱에서 열기" 버튼만 숨는다(코드·복사·앱스토어는 그대로).
# ⚠️ 이 값을 새로 넣거나 바꾼 뒤에는 `caddy reload` 가 아니라 인프라 층 재생성이 필요하다:
#   docker compose -f deploy/docker-compose.infra.yml --env-file ~/maramodi/.env up -d
KAKAO_NATIVE_APP_KEY=

# (2026-08-13: DOCKER_GID 항목을 제거했다. Jenkins 컨테이너가 마운트된 docker.sock 을
#  열기 위해 필요했던 값인데, CI/CD 가 GitHub Actions 로 옮겨가 서버에서 도는 Jenkins 가
#  없어졌다. 서버에서 이미지를 만드는 것은 이제 ubuntu 유저가 직접 하므로 이 값이 필요 없다.)

# ---------- 시크릿 파일 위치 (호스트 경로) ----------
# firebase-service-account.json 이 들어 있는 디렉토리. Spring 컨테이너가 여기서
# 읽기전용으로 마운트해 간다(FIREBASE_CREDENTIALS_PATH).
SECRETS_DIR=/home/ubuntu/maramodi/secrets

# ---------- 배포 상태 디렉터리 (호스트 경로, 저장소 밖) ----------
# 🔴 무중단 배포(blue/green)의 **활성 색 파일**이 여기 있다: `active-upstream.conf`.
# Caddy 가 마운트해 읽고, deploy.sh 가 전환할 때 이 파일만 바꾼 뒤 `caddy reload` 한다.
#
# **저장소 안에 두면 안 된다** — 배포 잡이 `git reset --hard origin/dev` 를 하므로 매 배포마다
# 활성 색이 커밋된 값으로 되돌아가고, 트래픽이 방금 세운 옛 색을 향해 전부 502 가 된다.
#
# 최초 1회: `scp deploy/active-upstream.conf.example modi:/home/ubuntu/maramodi/active-upstream.conf`
MARAMODI_STATE_DIR=/home/ubuntu/maramodi

# ---------- PostgreSQL ----------
POSTGRES_DB=modi
POSTGRES_USER=modi
# 로컬 개발값(modi)을 그대로 쓰지 않는다:  openssl rand -base64 24
POSTGRES_PASSWORD=

# ---------- MinIO (프로필 사진 등 이미지 업로드) ----------
# 이 계정으로 Spring이 버킷을 만들고 presigned URL을 발급한다. 로컬 기본값(minioadmin)을
# 그대로 쓰지 않는다:  openssl rand -base64 24
MINIO_ROOT_USER=modi
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=modi

# ---------- AI (OpenAI 직접) ----------
# 아카이브 자동 태깅(Spring 직접 호출)과 투두 추천(AI 서버)이 같은 키를 쓴다.
# 값은 OpenAI 플랫폼 키(sk-...)다. (2026-08-13: 회수된 게이트웨이의 이름을 딴 변수명을 개명했다.)
# ⚠️ 이 이름을 또 바꿀 때는 **코드와 이 .env 를 같은 배포에서** 함께 바꿀 것 — 어긋나면
# 부팅은 성공하고 AI 기능만 조용히 꺼진다(로그에 흔적이 없어 발견이 늦는다).
OPENAI_API_KEY=
# AI 서버(투두 추천)가 부를 주소. Spring 쪽은 SPRING_AI_OPENAI_BASE_URL 로 따로 준다.
OPENAI_BASE_URL=https://api.openai.com/v1/
# 태깅·요약·추천 **세 기능이 같은 모델을 쓴다**(2026-08-13 통일, ai/docs/EXPERIMENTS.md #34).
# 이 줄은 AI 서버(투두 추천)용이고, Spring 쪽 두 개는 아래 두 줄이다.
OPENAI_MODEL=gpt-5.4-nano
SPRING_AI_OPENAI_BASE_URL=https://api.openai.com/v1/
SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=gpt-5.4-nano
ARCHIVE_SUMMARY_MODEL=gpt-5.4-nano
# 자료 임베딩 백필. 평소에는 비워 둔다(= false) — 자료 1건당 LLM 호출 1회라
# 돈이 나간다. 기존 자료를 채울 때만 true 로 한 번 기동한 뒤 다시 지운다.
# ⚠️ 임베딩 모델은 Spring(ARCHIVE_EMBEDDING_MODEL)과 AI 서버(OPENAI_EMBEDDING_MODEL)가
#    같아야 한다. 둘 다 application.yml / config.py 기본값이 text-embedding-3-small 이다.
ARCHIVE_BACKFILL_EMBEDDINGS=false

# ---------- YouTube Data API v3 (유튜브 링크 저장) ----------
# 🔴 **운영에서는 사실상 필수다.** 운영 서버는 데이터센터 IP 라 youtube.com HTML 요청이
# 302 로 구글 CAPTCHA(google.com/sorry)에 걸린다(2026-08-04 실측). Data API 가 유일한
# 경로이고 HTML 폴백은 없다 — 비우면 유튜브 링크만 전부 등록에 실패한다.
# 발급 방법은 server/.env.example 참고. 로컬과 같은 키를 쓴다(IP 제한 없음).
YOUTUBE_API_KEY=

# ---------- 내부 통신 (Spring ↔ AI 서버 공유 시크릿) ----------
# 양쪽이 같은 값을 받는다. 비우면 검증을 건너뛰므로 운영에서는 반드시 채운다:
#   openssl rand -hex 32
INTERNAL_API_KEY=

# ---------- SMTP (이메일 자체가입 인증코드) ----------
# 비우면 인증코드 발송 API만 503이 되고 나머지는 정상 동작한다.
# Gmail을 쓴다면 SPRING_MAIL_PASSWORD는 구글 계정 비밀번호가 아니라 "앱 비밀번호"(2단계 인증
# 활성화 후 발급)를 써야 한다 — 일반 비밀번호는 SMTP 인증에서 거부된다.
# 포트/STARTTLS는 application.yml에 기본값이 있어 호스트/계정/비번 세 개만 채우면 된다.
SPRING_MAIL_HOST=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
